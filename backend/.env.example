# LLM Provider Configuration
# Supported providers: "gemini" or "openai"
LLM_PROVIDER=gemini

# Google Gemini API Key
GEMINI_API_KEY=

# OpenAI API Key (optional, if using OpenAI)
OPENAI_API_KEY=

# Storage paths (relative to project root or absolute)
DATA_DIR=../data
RESUMES_DIR=../data/resumes
FACT_BASE_FILE=../data/fact_base.json

# Server settings
HOST=127.0.0.1
PORT=8000
